<UserControl x:Class="CareerLiveryManager.App.Views.ApplyLiveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBrush}">
    <Grid Margin="40,32" MaxWidth="720" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="APPLY LIVERY" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Aircraft.Title}" FontSize="26" FontWeight="Bold"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"/>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#4A3A1E" Background="#1F1810" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,20"
                Visibility="{Binding IsSimRunning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="MSFS is currently running. Close the game completely before applying changes." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
        </Border>

        <Button Grid.Row="2" Content="Choose livery folder..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                Command="{Binding BrowseLiverySourceCommand}" Margin="0,0,0,20"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20"
                Visibility="{Binding DetectedLiveries.Count, Converter={StaticResource CountToVisibility}}">
            <StackPanel>
                <TextBlock Text="DETECTED LIVERY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding DetectedLiveries}" SelectedItem="{Binding SelectedLivery}" DisplayMemberPath="BaseFolderName" Margin="0,0,0,16"/>
                <Border Width="380" Height="230" Background="#0A0D11" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left"
                        Visibility="{Binding SelectedLivery.ThumbnailPath, Converter={StaticResource StringToVisibility}}">
                    <Image Source="{Binding SelectedLivery.ThumbnailPath, Converter={StaticResource FilePathToImage}}" Stretch="Uniform" Margin="4"/>
                </Border>
            </StackPanel>
        </Border>

        <CheckBox Grid.Row="4" Content="Use the Dynamic Registration variant (recommended, when available)"
                  IsChecked="{Binding UseDynamicRegistration}" Margin="0,0,0,20"
                  IsEnabled="{Binding SelectedLivery.HasDr}"/>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageColor}" TextWrapping="Wrap" Margin="0,0,0,20"
                   FontFamily="{StaticResource MonoFont}" FontSize="12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Generate preview" Style="{StaticResource SecondaryButton}" Command="{Binding GeneratePreviewCommand}" Margin="0,0,10,0"/>
            <Button Content="Apply" Command="{Binding ApplyLiveryCommand}"
                    IsEnabled="{Binding CanApply}"/>
        </StackPanel>

        <Border Grid.Row="7" Style="{StaticResource Card}" Padding="20"
                Visibility="{Binding Preview, Converter={StaticResource NullToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding Preview.PackageFolder}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border BorderThickness="1" CornerRadius="4" Padding="9,5" BorderBrush="#1B4A57" Background="#0E1A1F" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Preview.WinningLiveryName}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <Border BorderThickness="1" CornerRadius="4" Padding="9,5" BorderBrush="{StaticResource BorderStrongBrush}">
                        <TextBlock Text="OFFICIAL NOT MODIFIED" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="FILES THAT WILL BE COPIED" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Preview.Files}" MaxHeight="200" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativePath}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>

    <!-- Success modal -->
    <Grid Background="#B3000000" Visibility="{Binding ShowSuccessModal, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource Card}" Padding="36" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="#0E1A16" BorderBrush="#23503F" BorderThickness="1" Margin="0,0,0,18">
                    <Path Data="M6 10.5 L8.6 13 L14 7.5" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="20" Height="14" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="Livery applied" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Aircraft.Title, StringFormat='Your Career copy of the {0} will show this livery.'}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Open MSFS again so it rescans the Community folder." Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SuccessPackageFolder}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22"/>
                <Button Content="OK" Padding="32,10" HorizontalAlignment="Center" Command="{Binding CloseSuccessModalCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
