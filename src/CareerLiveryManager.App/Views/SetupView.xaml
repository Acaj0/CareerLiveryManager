<UserControl x:Class="CareerLiveryManager.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             Background="{StaticResource CanvasBrush}">
    <Grid Margin="48,40" MaxWidth="620" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="INITIAL SETUP" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
            <TextBlock Text="Point the app at your MSFS folders" FontSize="26" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="28">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="Detect automatically" Command="{Binding DetectAutomaticallyCommand}"/>
                    <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                        <Run Text="On Game Pass / Xbox app? "/>
                        <Hyperlink NavigateUri="https://github.com/Acaj0/CareerLiveryManager/blob/main/docs/GAME_PASS_SETUP.md"
                                   RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentBrush}">
                            <Run Text="See the setup guide"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="OFFICIAL CONTENT FOLDER" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Text="{Binding OfficialPath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding BrowseOfficialCommand}"/>
                </Grid>
                <TextBlock Text="Steam installs: ...\Official2024\Steam — Microsoft Store installs: ...\Official2024\OneStore"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="Note: aircraft must be downloaded in-game first, or the Official2024 folder will look empty."
                           Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,0,0,20"/>

                <TextBlock Text="COMMUNITY FOLDER" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Text="{Binding CommunityPath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding BrowseCommunityCommand}"/>
                </Grid>

                <TextBlock Text="Official MSFS packages are never modified. Everything this app does happens inside your Community folder."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,20"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageColor}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>
                <Button Content="Continue" HorizontalAlignment="Left" Command="{Binding ContinueCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
