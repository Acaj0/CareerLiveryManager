<UserControl x:Class="CareerLiveryManager.App.Views.Callout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A short notice with an icon: warning (amber) or info (cyan). The text wraps to the width it's given. -->
    <Border x:Name="Frame" Style="{StaticResource WarningCallout}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path x:Name="Glyph" Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarningBrush}"
                  Margin="0,1,12,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,3"/>
                <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
