<Window x:Class="CareerLiveryManager.App.Views.DiagnosticReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export diagnostic report"
        Width="560" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="DIAGNOSTIC REPORT" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
            <TextBlock Text="Export a report for a bug report" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,18"
                       Text="Creates one .zip file you can attach to a bug report, so nobody has to ask you for screenshots of the log."/>

            <TextBlock Text="WHAT'S INCLUDED" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
            <ItemsControl x:Name="IncludedList" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="NEVER INCLUDED" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
            <ItemsControl x:Name="ExcludedList" Margin="0,0,0,18">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,4" Foreground="{StaticResource SuccessBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox x:Name="HideUserNameCheckBox" IsChecked="True" Margin="0,0,0,22">
                <TextBlock TextWrapping="Wrap" FontSize="13"
                           Text="Hide my Windows username (C:\Users\Jane becomes C:\Users\&lt;redacted&gt; in every file)"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Choose where to save..." IsDefault="True" Click="Export_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
