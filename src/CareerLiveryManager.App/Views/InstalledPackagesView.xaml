<UserControl x:Class="CareerLiveryManager.App.Views.InstalledPackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CareerLiveryManager.App.Views"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450">
    <Grid Margin="40,32" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="COMMUNITY PACKAGES" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <TextBlock Text="Packages installed by this app" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding SummaryText, Converter={StaticResource StringToVisibility}}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" VerticalAlignment="Top"/>
        </Grid>

        <local:Callout Grid.Row="1" Margin="0,0,0,16" Text="{Binding StatusMessage}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>

        <!-- Empty state: says what this screen is for and what to do next. -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="0,0,0,40"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Border Width="56" Height="56" CornerRadius="28" Background="#0E1A1F" BorderBrush="#1B4A57" BorderThickness="1" Margin="0,0,0,18" HorizontalAlignment="Center">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconBox}" Stroke="{StaticResource AccentBrush}" Width="22" Height="22"/>
            </Border>
            <TextBlock Text="Nothing installed yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,22"
                       Text="Pick an aircraft, apply a livery to it, and the package shows up here. From here you can find its folder or remove it."/>
            <Button Content="Choose an aircraft" HorizontalAlignment="Center" Command="{Binding BackCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Packages}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="180" Height="86" Margin="0,0,18,0" Background="#0A0D11" CornerRadius="4" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToImage}}" Stretch="Uniform"/>
                                    <TextBlock Text="No preview" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Visibility="{Binding ThumbnailPath, Converter={StaticResource NullToInverseVisibility}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding AircraftSimObjectName}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Margin="10,0,0,0" BorderThickness="1" CornerRadius="4" Padding="7,2" BorderBrush="#1B4A57" Background="#0E1A1F" VerticalAlignment="Center"
                                            Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ActivityDisplayName}" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding PackageFolder}" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageFolder}"/>
                            </StackPanel>

                            <!-- Row actions. Removing asks first, inside the card, so nothing is deleted by one stray click. -->
                            <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="206">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding IsConfirmingRemove, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Button Content="Open folder" Style="{StaticResource CompactButton}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Remove" Style="{StaticResource CompactDangerButton}"
                                            Command="{Binding DataContext.AskRemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" Visibility="{Binding IsConfirmingRemove, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Remove this package?" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Only this package is deleted. Your livery download isn't touched." TextWrapping="Wrap" MaxWidth="206" TextAlignment="Right"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,10"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Style="{StaticResource CompactButton}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Yes, remove" Style="{StaticResource CompactDangerButton}"
                                                Command="{Binding DataContext.ConfirmRemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
