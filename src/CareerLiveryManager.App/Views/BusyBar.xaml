<UserControl x:Class="CareerLiveryManager.App.Views.BusyBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="4" IsVisibleChanged="BusyBar_IsVisibleChanged">
    <!-- A thin indeterminate bar: a short accent segment sliding across the track while work is running. -->
    <Border Background="{StaticResource BorderStrongBrush}" CornerRadius="2" ClipToBounds="True">
        <Border x:Name="Segment" Width="140" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource AccentBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="-140"/>
            </Border.RenderTransform>
        </Border>
    </Border>
</UserControl>
