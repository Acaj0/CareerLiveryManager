<Window x:Class="CareerLiveryManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CareerLiveryManager.App"
        xmlns:vm="clr-namespace:CareerLiveryManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Career Livery Manager" Height="640" Width="960"
        Icon="Resources/Icon/clm.ico"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Persistent header: hidden only on the Home screen -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="24,14"
                Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="26" Height="26" Background="#0F151B" CornerRadius="6" Margin="0,0,10,0">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="100" Height="100">
                                <Polygon Points="50,16 50,64 15,82" Fill="{StaticResource AccentBrush}"/>
                                <Polygon Points="50,16 85,82 50,64" Fill="{StaticResource AccentDeepBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Career Livery Manager" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Installed packages" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,10,0"
                        Command="{Binding GoToInstalledPackagesCommand}"/>

                <Button Grid.Column="2" Content="☕ Buy me a coffee" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,10,0"
                        Command="{Binding OpenBuyMeACoffeeCommand}"/>

                <Button Grid.Column="3" Content="Options" Style="{StaticResource SecondaryButton}" Padding="14,8"
                        Click="SettingsButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="Open logs" Command="{Binding OpenLogsCommand}"/>
                            <MenuItem Header="Change folders" Command="{Binding ChangeFoldersCommand}"/>
                            <Separator/>
                            <MenuItem Header="Check for updates automatically" IsCheckable="True"
                                      IsChecked="{Binding CheckForUpdatesEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleCheckForUpdatesCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- Update available banner: shown app-wide (including Home) once a check finds a newer release -->
        <Border Grid.Row="1" Background="#14202B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="24,10"
                Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerText}" FontSize="12" TextWrapping="Wrap"/>
                    <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Update Now" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="10,0,0,0"
                        Command="{Binding UpdateNowCommand}" IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBool}}"/>

                <Button Grid.Column="2" Content="Later" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="10,0,0,0"
                        Command="{Binding DismissUpdateBannerCommand}" IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBool}}"/>
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}"/>

        <!-- Persistent footer: hidden only on the Home screen -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="24,10"
                Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding AppVersionText}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                        <Hyperlink NavigateUri="https://antoniodeabreu.dev/career-livery-manager" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentBrush}">
                            <Run Text="Send feedback"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                    <Run Text="Need help? "/>
                    <Hyperlink NavigateUri="https://github.com/Acaj0/CareerLiveryManager/issues" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentBrush}">
                        <Run Text="Report an issue on GitHub"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
